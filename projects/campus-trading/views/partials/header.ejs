<header class="header">
  <div class="container header-inner">
    <a href="/" class="logo">🎓 校园二手交易</a>
    <nav>
      <a href="/">首页</a>
      <% if (user) { %>
        <a href="/favorites">❤️ 收藏</a>
        <a href="/dashboard">📊 个人中心</a>
        <a href="/products/publish">发布商品</a>
        <a href="/orders/my">我的订单</a>
        <span class="user-info"><%= user.username %></span>
        <a href="/auth/logout" class="btn btn-outline btn-sm">退出</a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-outline btn-sm">登录</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">注册</a>
      <% } %>
    </nav>
  </div>
</header>
