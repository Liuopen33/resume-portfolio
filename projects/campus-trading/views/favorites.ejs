<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>我的收藏 - 校园二手交易</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('partials/header') %>
<div class="container">
  <h2 class="page-title">❤️ 我的收藏</h2>
  <% if (favorites.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">💔</div>
      <h3>还没有收藏</h3>
      <p>去首页逛逛，收藏你喜欢的宝贝吧</p>
      <a href="/" class="btn btn-primary">去逛逛</a>
    </div>
  <% } %>
  <div class="product-grid">
    <% favorites.forEach(f => { const p = f.product; %>
      <div class="product-card">
        <a href="/product/<%= p.id %>" class="product-link">
          <div class="product-image">
            <img src="/image/<%= p.id %>" alt="<%= p.title %>" loading="lazy">
          </div>
        </a>
        <div class="product-info">
          <a href="/product/<%= p.id %>" class="product-link">
            <h3 class="product-title"><%= p.title %></h3>
          </a>
          <p class="product-price">¥<%= p.price.toFixed(2) %></p>
          <div class="product-meta">
            <span><%= p.category %></span>
            <span><%= p.status === 'active' ? '🟢 在售' : p.status === 'sold' ? '已售' : '已预订' %></span>
          </div>
        </div>
        <button class="fav-btn-top fav-remove" onclick="toggleFav(event, <%= p.id %>, this)" title="取消收藏">❌</button>
      </div>
    <% }) %>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
